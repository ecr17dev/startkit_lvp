{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Starter manifest",
    "description": "Versions of the stack validated for this release (generated by php artisan starter:manifest).",
    "type": "object",
    "required": ["starter", "runtime", "composer", "npm", "services"],
    "properties": {
        "starter": { "type": "object", "required": ["version", "laravel_branch"] },
        "runtime": { "type": "object" },
        "composer": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
        "npm": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
        "ui": { "type": "object" },
        "services": { "type": "object" },
        "reviewed_at": { "type": "string", "format": "date" }
    }
}
