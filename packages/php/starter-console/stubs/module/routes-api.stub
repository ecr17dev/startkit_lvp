<?php

use App\Http\Controllers\Api\V1\{{ Model }}Controller;
use Illuminate\Support\Facades\Route;

/*
| {{ Labels }} JSON API (generated by starter:make-module). Loaded by
| routes/api.php inside v1 with auth:sanctum and throttle:api.
*/

Route::middleware('ability:read')->group(function () {
    Route::get('{{ slug }}', [{{ Model }}Controller::class, 'index'])->name('{{ slug }}.index');
    Route::get('{{ slug }}/{{{ model }}}', [{{ Model }}Controller::class, 'show'])->name('{{ slug }}.show');
});

Route::middleware('ability:write')->group(function () {
    Route::post('{{ slug }}', [{{ Model }}Controller::class, 'store'])->name('{{ slug }}.store');
    Route::patch('{{ slug }}/{{{ model }}}', [{{ Model }}Controller::class, 'update'])->name('{{ slug }}.update');
    Route::delete('{{ slug }}/{{{ model }}}', [{{ Model }}Controller::class, 'destroy'])->name('{{ slug }}.destroy');
});
