<?php

namespace App\Actions\{{ Models }};

use App\Models\{{ Model }};
use App\Models\User;
use Illuminate\Support\Facades\Gate;
use Illuminate\Support\Facades\Validator;

/**
 * Update a {{ label }} (only the fields sent). The audit records what changed.
 */
class Update{{ Model }}
{
    /**
     * @param  array<string, mixed>  $input
     */
    public function handle(User $actor, {{ Model }} ${{ model }}, array $input): {{ Model }}
    {
        Gate::forUser($actor)->authorize('update', ${{ model }});

        $rules = array_map(fn (array $rules) => ['sometimes', ...$rules], Create{{ Model }}::rules(${{ model }}));

        /** @var array<string, mixed> $data */
        $data = Validator::make($input, $rules)->validate();

        ${{ model }}->fill($data);
        $changes = array_keys(${{ model }}->getDirty());
        ${{ model }}->save();

        if ($changes !== []) {
            audit('{{ permission }}.updated', ${{ model }}, ['fields' => $changes], $actor);
        }

        return ${{ model }};
    }
}
