<?php

namespace Tests\Feature\Modules;

use App\Models\{{ Model }};
use Illuminate\Foundation\Testing\RefreshDatabase;
use Inertia\Testing\AssertableInertia;
{{ testImports }}use Tests\TestCase;

/**
 * {{ Labels }} module (generated by starter:make-module): permissions,
 * validation, audit{{ testsNote }}.
 */
class {{ Models }}Test extends TestCase
{
    use {{ testTraits }}RefreshDatabase;

    /**
     * @param  array<string, mixed>  $overrides
     * @return array<string, mixed>
     */
    protected function payload(array $overrides = []): array
    {
        return [
{{ sampleData }}
            ...$overrides,
        ];
    }

    public function test_readers_see_the_list_but_cannot_change_it(): void
    {
        ${{ model }} = {{ Model }}::factory()->create();
        $reader = $this->userWithRole('reader');

        $this->get(route('{{ slug }}.index'))->assertRedirect(route('login'));

        $this->actingAs($reader)->get(route('{{ slug }}.index'))
            ->assertOk()
            ->assertInertia(fn (AssertableInertia $page) => $page
                ->component('{{ slug }}/Index')
                ->has('{{ models }}.data', 1)
                ->where('can.create', false));

        $this->actingAs($reader)->get(route('{{ slug }}.create'))->assertForbidden();
        $this->actingAs($reader)->post(route('{{ slug }}.store'), $this->payload())->assertForbidden();
        $this->actingAs($reader)->put(route('{{ slug }}.update', ${{ model }}), $this->payload())->assertForbidden();
        $this->actingAs($reader)->delete(route('{{ slug }}.destroy', ${{ model }}))->assertForbidden();
        $this->assertSame(1, {{ Model }}::query()->count());

        $this->actingAs($this->userWithRole([]))->get(route('{{ slug }}.index'))->assertForbidden();
    }

    public function test_editors_create_update_and_delete_with_audit(): void
    {
        $editor = $this->userWithRole('editor');

        $this->actingAs($editor)->post(route('{{ slug }}.store'), $this->payload(['{{ titleField }}' => '']))
            ->assertSessionHasErrors('{{ titleField }}');

        $this->actingAs($editor)->post(route('{{ slug }}.store'), $this->payload())
            ->assertRedirect(route('{{ slug }}.index'));

        ${{ model }} = {{ Model }}::query()->sole();
        $this->assertSame($editor->id, ${{ model }}->created_by);
        $this->assertDatabaseHas('audit_events', ['action' => '{{ permission }}.created', 'actor_id' => $editor->id]);

        $this->actingAs($editor)->get(route('{{ slug }}.edit', ${{ model }}))
            ->assertOk()
            ->assertInertia(fn (AssertableInertia $page) => $page->component('{{ slug }}/Edit')->where('{{ model }}.id', ${{ model }}->id));

        $this->actingAs($editor)->put(route('{{ slug }}.update', ${{ model }}), $this->payload(['{{ titleField }}' => {{ titleSample }}]))
            ->assertRedirect(route('{{ slug }}.index'));
        $this->assertSame({{ titleSample }}, ${{ model }}->refresh()->{{ titleField }});
        $this->assertDatabaseHas('audit_events', ['action' => '{{ permission }}.updated', 'actor_id' => $editor->id]);

        $this->actingAs($editor)->get(route('{{ slug }}.index', ['search' => 'no such {{ label }}']))
            ->assertInertia(fn (AssertableInertia $page) => $page->has('{{ models }}.data', 0));

        // Sorting only accepts the listed columns...
        $this->actingAs($editor)->get(route('{{ slug }}.index', ['sort' => '{{ titleField }}', 'direction' => 'desc']))
            ->assertInertia(fn (AssertableInertia $page) => $page->has('{{ models }}.data', 1)->where('filters.direction', 'desc'));
        $this->actingAs($editor)->get(route('{{ slug }}.index', ['sort' => 'password']))->assertSessionHasErrors('sort');

        $this->actingAs($editor)->delete(route('{{ slug }}.destroy', ${{ model }}))->assertRedirect(route('{{ slug }}.index'));
        $this->assertModelMissing(${{ model }});
        $this->assertDatabaseHas('audit_events', ['action' => '{{ permission }}.deleted', 'actor_id' => $editor->id]);
    }
