<script setup lang="ts">
import { Head, Link, router } from '@inertiajs/vue3';
import { Pencil, Plus, Trash2 } from '@lucide/vue';
import type { MenuAction } from '@/components/kit/ActionsMenu.vue';
import ActionsMenu from '@/components/kit/ActionsMenu.vue';
import type { DataTableColumn } from '@/components/kit/data-table';
import DataTable from '@/components/kit/DataTable.vue';
import PageHeader from '@/components/PageHeader.vue';
%%badgeImport%%import { Button } from '@starter/ui/components/button';
%%selectImport%%import { useTableQuery } from '@/composables/useTableQuery';
import { formatDate, t } from '@/lib/i18n';
import type { %%Model%%, %%Model%%Options } from '@/modules/%%slug%%/types';
import { create, destroy, edit, index } from '@/routes/%%slug%%';
import type { Paginated } from '@/types';

defineOptions({
    layout: {
        breadcrumbs: [{ title: '%%Labels%%', href: index() }],
    },
});

const props = defineProps<{
    %%models%%: Paginated<%%Model%%>;
    filters: { search?: string; sort?: string; direction?: string%%filterProp%% };
    options: %%Model%%Options;
    can: { create: boolean; update: boolean; delete: boolean };
}>();

// Search, sort and filters travel in the query string; the server applies
// them and paginates (DataTable in server mode)...
const query = useTableQuery(index().url, {
    search: props.filters.search,
    sort: props.filters.sort,
    direction: props.filters.direction,
%%filterState%%});

%%optionLabelFn%%const columns: DataTableColumn<%%Model%%>[] = [
    { key: '%%titleField%%', label: t('%%titleLabel%%'), sortable: true, card: 'title' },
%%columnDefs%%
    {
        key: 'updated_at',
        label: t('Last updated'),
        sortable: true,
        hideBelow: 'lg',
        format: (value) => formatDate(value as string | null),
    },
];

const actions = (%%model%%: %%Model%%): MenuAction[] => [
    ...(props.can.update
        ? [{ label: t('Edit'), icon: Pencil, href: edit(%%model%%.id) }]
        : []),
    ...(props.can.delete
        ? [
              {
                  label: t('Delete'),
                  icon: Trash2,
                  destructive: true,
                  separated: props.can.update,
                  confirm: {
                      title: t('Delete %%label%%'),
                      description: t(
                          'The %%label%% will be deleted. This cannot be undone.',
                      ),
                      action: t('Delete'),
                  },
                  onSelect: () =>
                      router.delete(destroy(%%model%%.id).url, {
                          preserveScroll: true,
                      }),
              },
          ]
        : []),
];
</script>

<template>
    <Head :title="t('%%Labels%%')" />

    <div class="flex flex-col gap-6 p-4 md:p-6">
        <PageHeader
            :title="t('%%Labels%%')"
            :description="t('Create and manage the %%labels%%.')"
        >
            <Button v-if="can.create" as-child>
                <Link :href="create()">
                    <Plus class="size-4" />
                    {{ t('New %%label%%') }}
                </Link>
            </Button>
        </PageHeader>

        <DataTable
            v-model:search="query.search"
            v-model:sort="query.sort"
            :rows="%%models%%.data"
            :columns="columns"
            :meta="%%models%%.meta"
            :label="t('%%Labels%%')"
            :search-placeholder="t('Search %%labels%%')"
            :empty-text="t('No %%labels%% found.')"
            server
        >
%%filterControl%%            <template #cell-%%titleField%%="{ row }">
                <Link
                    v-if="can.update"
                    :href="edit(row.id)"
                    class="font-medium hover:underline"
                    >{{ row.%%titleField%% || '—' }}</Link
                >
                <span v-else class="font-medium">{{ row.%%titleField%% || '—' }}</span>
            </template>
%%cellSlots%%            <template v-if="can.update || can.delete" #actions="{ row }">
                <ActionsMenu :items="actions(row)" />
            </template>
        </DataTable>
    </div>
</template>
