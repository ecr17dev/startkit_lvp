<script setup lang="ts">
import { Head, Link, router } from '@inertiajs/vue3';
import { watchDebounced } from '@vueuse/core';
import { Pencil, Plus, Search, Trash2 } from '@lucide/vue';
import { reactive } from 'vue';
import ConfirmDialog from '@/components/ConfirmDialog.vue';
import PageHeader from '@/components/PageHeader.vue';
import Pagination from '@/components/Pagination.vue';
%%badgeImport%%import { Button } from '@starter/ui/components/button';
import { Input } from '@starter/ui/components/input';
%%selectImport%%import {
    Table,
    TableBody,
    TableCell,
    TableEmpty,
    TableHead,
    TableHeader,
    TableRow,
} from '@starter/ui/components/table';
import { formatDate, t } from '@/lib/i18n';
import type { %%Model%%, %%Model%%Options } from '@/modules/%%slug%%/types';
import { create, destroy, edit, index } from '@/routes/%%slug%%';
import type { Paginated } from '@/types';

defineOptions({
    layout: {
        breadcrumbs: [{ title: '%%Labels%%', href: index() }],
    },
});

const props = defineProps<{
    %%models%%: Paginated<%%Model%%>;
    filters: { search?: string%%filterProp%% };
    options: %%Model%%Options;
    can: { create: boolean; update: boolean; delete: boolean };
}>();

const filters = reactive({
    search: props.filters.search ?? '',
%%filterState%%});

watchDebounced(
    filters,
    () => {
        router.get(
            index().url,
            {
                search: filters.search || undefined,
%%filterQuery%%            },
            { preserveState: true, preserveScroll: true, replace: true },
        );
    },
    { debounce: 300, deep: true },
);

%%optionLabelFn%%const remove = (%%model%%: %%Model%%) =>
    router.delete(destroy(%%model%%.id).url, { preserveScroll: true });
</script>

<template>
    <Head :title="t('%%Labels%%')" />

    <div class="flex flex-col gap-6 p-4 md:p-6">
        <PageHeader
            :title="t('%%Labels%%')"
            :description="t('Create and manage the %%labels%%.')"
        >
            <Button v-if="can.create" as-child>
                <Link :href="create()">
                    <Plus class="size-4" />
                    {{ t('New %%label%%') }}
                </Link>
            </Button>
        </PageHeader>

        <div class="flex flex-col gap-3 sm:flex-row">
            <div class="relative flex-1">
                <Search
                    class="absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground"
                />
                <Input
                    v-model="filters.search"
                    class="pl-9"
                    :placeholder="t('Search %%labels%%')"
                    :aria-label="t('Search %%labels%%')"
                />
            </div>
%%filterControl%%        </div>

        <div class="rounded-lg border">
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead>{{ t('%%titleLabel%%') }}</TableHead>
%%headers%%                        <TableHead class="hidden lg:table-cell">{{
                            t('Last updated')
                        }}</TableHead>
                        <TableHead class="w-24 text-right">{{
                            t('Actions')
                        }}</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    <TableRow v-for="%%model%% in %%models%%.data" :key="%%model%%.id">
                        <TableCell class="font-medium">
                            <Link
                                v-if="can.update"
                                :href="edit(%%model%%.id)"
                                class="hover:underline"
                                >{{ %%model%%.%%titleField%% || '—' }}</Link
                            >
                            <template v-else>{{
                                %%model%%.%%titleField%% || '—'
                            }}</template>
                        </TableCell>
%%cells%%                        <TableCell
                            class="hidden text-sm text-muted-foreground lg:table-cell"
                            >{{ formatDate(%%model%%.updated_at) }}</TableCell
                        >
                        <TableCell class="text-right">
                            <div class="flex justify-end gap-1">
                                <Button
                                    v-if="can.update"
                                    variant="ghost"
                                    size="icon"
                                    as-child
                                >
                                    <Link
                                        :href="edit(%%model%%.id)"
                                        :aria-label="t('Edit')"
                                    >
                                        <Pencil class="size-4" />
                                    </Link>
                                </Button>
                                <ConfirmDialog
                                    v-if="can.delete"
                                    :title="t('Delete %%label%%')"
                                    :description="
                                        t(
                                            'The %%label%% will be deleted. This cannot be undone.',
                                        )
                                    "
                                    :confirm-text="t('Delete')"
                                    @confirm="remove(%%model%%)"
                                >
                                    <Button
                                        variant="ghost"
                                        size="icon"
                                        class="text-destructive"
                                        :aria-label="t('Delete')"
                                    >
                                        <Trash2 class="size-4" />
                                    </Button>
                                </ConfirmDialog>
                            </div>
                        </TableCell>
                    </TableRow>
                    <TableEmpty v-if="!%%models%%.data.length" :colspan="%%colspan%%">
                        {{ t('No %%labels%% found.') }}
                    </TableEmpty>
                </TableBody>
            </Table>
        </div>

        <Pagination :meta="%%models%%.meta" />
    </div>
</template>
