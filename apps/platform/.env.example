APP_NAME="Laravel Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL holds the application data, sessions, cache/locks and the queue.
# With Docker use DB_HOST=postgres (profile local-db).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=starter
DB_USERNAME=starter
DB_PASSWORD=secret
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local mail is captured by Mailpit (docker profile dev-mail, UI on :8025).
# The mail server can also be configured from Admin → Settings → Mail.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: Resend (MAIL_MAILER=resend)
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------------------
# Starter kit (config/starter.php)
# ----------------------------------------------------------------------
STARTER_FEATURE_ORGANIZATIONS=false
STARTER_FEATURE_AI=true
STARTER_FEATURE_RAG=false
STARTER_FEATURE_POSTGREST=false

# email-otp (recommended) | email-otp+password
STARTER_AUTH_METHOD=email-otp
# Initial registration mode (open | invite-only | closed); afterwards it is
# changed from Admin → Settings → Authentication.
STARTER_REGISTRATION=invite-only
STARTER_INVITATION_TTL_DAYS=7

# One-time codes. The HMAC secret of the code verifiers defaults to APP_KEY.
STARTER_OTP_SECRET=
STARTER_OTP_LENGTH=6
STARTER_OTP_TTL=5
STARTER_OTP_MAX_ATTEMPTS=5
STARTER_OTP_RESEND_COOLDOWN=60

STARTER_AUDIT_RETENTION_DAYS=365

# The owner is created with `php artisan starter:owner you@example.com`.

# AI provider keys can be stored encrypted from the panel, or referenced
# from the environment with a secret reference such as env:OPENAI_API_KEY
# (allowed names: config/starter.php ai.secret_refs or STARTER_AI_SECRET_*).
STARTER_AI_INTERRUPT_AFTER_MINUTES=15
# The seeder installs a simulated provider (no network, clearly labelled)
# so a local installation chats without API keys. Off in production.
STARTER_AI_SIMULATED=true
# Minutes to confirm a change prepared by an agent tool.
STARTER_AI_PROPOSAL_TTL=10
STARTER_AI_GENERATE_TITLES=true
# Chat attachments: private disk and retention in days (0 keeps them).
STARTER_AI_ATTACHMENTS_DISK=local
STARTER_AI_ATTACHMENTS_RETENTION_DAYS=30
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Knowledge (RAG) — requires STARTER_FEATURE_RAG=true; activated from
# Admin → Knowledge after the diagnostics (pgvector).
STARTER_RAG_STRATEGY=hybrid
STARTER_RAG_TOP_K=6
# Run scheduled source syncs (scheduler: starter:rag-maintain).
STARTER_RAG_AUTOMATIC=false
# Embedding calls in flight per AI connection.
STARTER_RAG_CONCURRENCY=2
# Larger ingestions wait for a confirmed budget.
STARTER_RAG_CONFIRM_ABOVE_TOKENS=250000
STARTER_RAG_CONFIRM_ABOVE_COST=0.25
STARTER_RAG_QUEUE=
STARTER_RAG_STALE_AFTER_MINUTES=10
STARTER_RAG_DISK=local
STARTER_RAG_MAX_FILE_MB=20
STARTER_RAG_EXACT_SEARCH_BELOW=20000
# Retrieval traces (queries and hits) kept for analytics, in days.
STARTER_RAG_RETRIEVAL_RETENTION_DAYS=90
# Safe URL reader: timeout, size, pages and optional host allow list.
STARTER_RAG_FETCH_TIMEOUT=15
STARTER_RAG_FETCH_MAX_MB=10
STARTER_RAG_MAX_PAGES=200
STARTER_RAG_ALLOWED_HOSTS=
STARTER_RAG_USER_AGENT=StarterKnowledgeBot/1.0
# Filesystem disks allowed as knowledge sources (comma separated, e.g. s3).
STARTER_RAG_DISKS=

# PostgREST (profile postgrest) — only when STARTER_FEATURE_POSTGREST=true.
# The secret (32+ characters) signs the short JWTs Laravel sends; the same
# value goes to PGRST_JWT_SECRET. `php artisan starter:postgrest-install`
# prepares the api schema (and the roles, or prints their SQL for the DBA).
POSTGREST_URL=http://127.0.0.1:3000
POSTGREST_JWT_SECRET=
POSTGREST_JWT_TTL=300
POSTGREST_DB_USER=starter_postgrest_authenticator
POSTGREST_DB_PASSWORD=
POSTGREST_DIRECT_TOKENS=false

VITE_APP_NAME="${APP_NAME}"
