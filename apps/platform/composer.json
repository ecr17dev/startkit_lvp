{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "starter/platform",
    "type": "project",
    "description": "Laravel 13 + Laravel AI SDK + Vue/Inertia starter platform.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/php/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../tooling/create-starter",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "dedoc/scramble": "^0.13.49",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/ai": "^1.3",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "resend/resend-php": "^1.17",
        "spatie/laravel-permission": "^8.3",
        "starter/administration": "^0.1",
        "starter/ai": "^0.1",
        "starter/console": "^0.1",
        "starter/identity": "^0.1",
        "starter/knowledge": "^0.1",
        "symfony/http-client": "^7.4",
        "symfony/mailgun-mailer": "^7.4",
        "symfony/postmark-mailer": "^7.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "phpunit/phpunit": "^12.5.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan db:seed --force",
            "pnpm install",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel",
            "pint --parallel ../../packages/php ../../tooling/create-starter"
        ],
        "lint:check": [
            "pint --parallel --test",
            "pint --parallel --test ../../packages/php ../../tooling/create-starter"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm run check",
            "pnpm run types:check",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
