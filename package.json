{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "laravel-starter",
    "private": true,
    "packageManager": "pnpm@10.28.0",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "pnpm --filter @starter/platform dev",
        "build": "pnpm --filter @starter/platform build",
        "check": "pnpm --filter @starter/platform check",
        "check:fix": "pnpm --filter @starter/platform check:fix",
        "types:check": "pnpm --filter @starter/platform types:check",
        "test": "pnpm -r --if-present test",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "api:client:generate": "pnpm --filter @starter/api-client generate"
    }
}
