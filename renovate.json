{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", ":semanticCommits", ":timezone(America/Santiago)"],
    "schedule": ["before 6am"],
    "prConcurrentLimit": 8,
    "rangeStrategy": "bump",
    "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
    "vulnerabilityAlerts": { "enabled": true, "labels": ["security"] },
    "osvVulnerabilityAlerts": true,
    "packageRules": [
        {
            "description": "Laravel 13 is pinned: a new major version requires an explicit decision and upgrade guide.",
            "matchPackageNames": ["laravel/framework"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            "description": "Group Laravel ecosystem packages.",
            "groupName": "laravel ecosystem",
            "matchPackageNames": ["laravel/**", "inertiajs/inertia-laravel", "spatie/laravel-permission", "dedoc/scramble"]
        },
        {
            "description": "Group the Vue / Inertia / Tailwind front-end stack.",
            "groupName": "frontend stack",
            "matchPackageNames": ["vue", "vue-tsc", "@inertiajs/**", "tailwindcss", "@tailwindcss/**", "reka-ui", "@vueuse/**", "vite-plus", "@voidzero-dev/**", "laravel-vite-plugin", "@laravel/**"]
        },
        {
            "description": "Sensitive areas always need a human review (auth, database, AI SDK).",
            "matchPackageNames": ["laravel/fortify", "laravel/sanctum", "laravel/ai", "spatie/laravel-permission", "pgvector/**", "postgres", "pgvector/pgvector", "postgrest/postgrest"],
            "automerge": false,
            "labels": ["needs-review"]
        },
        {
            "description": "Patch updates of dev tooling can be merged automatically once CI is green.",
            "matchDepTypes": ["devDependencies", "require-dev"],
            "matchUpdateTypes": ["patch"],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true
        },
        {
            "description": "Docker images are pinned and reviewed.",
            "matchDatasources": ["docker"],
            "pinDigests": true,
            "automerge": false
        },
        {
            "description": "Runtimes: track PHP and Node LTS without promoting automatically.",
            "matchPackageNames": ["php", "node"],
            "matchUpdateTypes": ["major"],
            "automerge": false,
            "labels": ["runtime"]
        }
    ]
}
